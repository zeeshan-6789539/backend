# Local development defaults — this file is committed.
# Never put production credentials here. For machine-specific overrides
# create .env.local (still gitignored); it takes precedence over this file.

# Application
NODE_ENV=development
PORT=5000
API_PREFIX=api
API_VERSION=1
CORS_ORIGINS=https://rms-frontend-roan-psi.vercel.app,http://localhost:5001
REQUEST_TIMEOUT_MS=15000

# Logging
LOG_LEVEL=debug

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Database
# DATABASE_URL=postgresql://postgres.uybfwltkwjojytrnkapj:5qqZj1IvGOqrg2bA@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:123@localhost:5432/pdm
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_LOG_QUERIES=false

