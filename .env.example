# Copy to .env and fill in. .env is the only env file the app reads, and it is gitignored.
# Production values are set in the hosting dashboard (Vercel), never in a committed file.
# Every variable is validated in src/config/env.validation.ts — startup fails listing all invalid ones.
# REQUIRED: DATABASE_URL, JWT_ACCESS_SECRET, JWT_REFRESH_SECRET, MAIL_HOST, MAIL_USER, MAIL_PASSWORD,
# MAIL_ENCRYPTION_KEY, FRONTEND_URL. Everything else has a default.

# Application
NODE_ENV=development
# Product name shown in emails and the Swagger title
APP_NAME=RMS
# The frontend expects the API on :5000
PORT=5000
API_PREFIX=api
API_VERSION=1
# Comma-separated; must include the frontend origin (http://localhost:5001)
CORS_ORIGINS=http://localhost:5001
REQUEST_TIMEOUT_MS=15000

# Logging — fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Database (required: DATABASE_URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rms
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_LOG_QUERIES=false

# JWT (required: both secrets, at least 32 chars each, and different from each other)
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-random-string-of-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-random-string-32-chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=rms-backend

# Super admin seed — consumed only by `pnpm db:seed`.
# Optional for the API to boot; SEED_SUPER_ADMIN_PASSWORD (8-128 chars) is required for seeding.
SEED_SUPER_ADMIN_EMAIL=superadmin@mifa.mifa
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Super Admin

# Mail — welcome, password-change and monthly rent invoice emails
# (required: MAIL_HOST, MAIL_USER, MAIL_PASSWORD, MAIL_ENCRYPTION_KEY, FRONTEND_URL)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=replace-me
MAIL_PASSWORD=replace-me
MAIL_FROM=no-reply@rms.local
# 64 hex chars; encrypts companies.mail_password. Changing it makes stored passwords undecryptable.
# Generate with: openssl rand -hex 32
MAIL_ENCRYPTION_KEY=
# Login link in welcome and password-changed emails
FRONTEND_URL=http://localhost:5001

# Voice assistant — a Google AI Studio API key. Optional: without it POST /assistant/session answers 503.
GOOGLE_STUDIO_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# 1-120
GEMINI_SESSION_TTL_MINUTES=30
