# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
CORS_ORIGINS=http://localhost:3000,http://localhost:5001,http://localhost:5173
REQUEST_TIMEOUT_MS=15000

# Logging
LOG_LEVEL=debug

# Swagger
SWAGGER_ENABLED=true
SWAGGER_PATH=docs

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rms
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_LOG_QUERIES=false

# JWT — generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-with-a-random-string-of-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-me-with-a-different-random-string-32-chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=rms-backend

# Super admin seed — consumed by `pnpm db:seed` and `pnpm db:seed:demo`.
# Optional for the API to boot; required for seeding to succeed.
# Every seeded user (super admin and demo users) signs in with SEED_SUPER_ADMIN_PASSWORD.
SEED_SUPER_ADMIN_EMAIL=superadmin@rms.local
SEED_SUPER_ADMIN_PASSWORD=
SEED_SUPER_ADMIN_NAME=Super Admin

# Demo dealer seed — consumed only by `pnpm db:seed:demo` (refuses to run in production).
# Creates a demo dealership whose client admin signs in with this email and SEED_SUPER_ADMIN_PASSWORD.
SEED_DEMO_ADMIN_EMAIL=dealer@demo.local
SEED_DEMO_ADMIN_NAME=Demo Dealer

# Mail — used to send welcome and password-change emails
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=replace-me
MAIL_PASSWORD=replace-me
MAIL_FROM=no-reply@rms.local

# Voice assistant — a Google AI Studio API key. Optional: without it POST /assistant/session answers 503.
GOOGLE_STUDIO_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_SESSION_TTL_MINUTES=30
